# Copy to .env for local dev. Never commit real secrets.
PORT=3001
DATABASE_URL=postgresql://bccc:bccc@localhost:5432/bccc?schema=public

# Open CORS for now (server allows all origins when ALLOWED_ORIGINS=*).
# TODO: restrict to real frontend domains for production, e.g.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=*

# M-Pesa (sandbox — keep for now)
MPESA_API_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PAYBILL_NUMBER=174379
MPESA_PASSKEY=
YOUR_APP_URL=http://localhost:3001
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
