# Copy to .env for local dev. Never commit real secrets.
PORT=3001
DATABASE_URL=postgresql://bccc:bccc@localhost:5432/bccc?schema=public

# Open CORS for now (server allows all origins when ALLOWED_ORIGINS=*).
# TODO: restrict to real frontend domains for production, e.g.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=*

# M-Pesa (sandbox — keep for now)
MPESA_API_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_QUERY_URL=https://sandbox.safaricom.co.ke/mpesa/stkpushquery/v1/query
MPESA_CONSUMER_KEY=Qy8Y8Yl2M2PHLLgVysn0CupQGsZPeVX8fIAH34kq636IC9jQ
MPESA_CONSUMER_SECRET=SP1IhyXLe1posbFunNxGAe2jAE8SWR3ODtI1eCaBDtfPSsfet6jowwNRG0qGydGs
MPESA_PAYBILL_NUMBER=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
YOUR_APP_URL=http://localhost:3001
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Admin console (backend is the source of truth for admin accounts).
# JSON Web Token signing key — REQUIRED in production (long random string).
JWT_SECRET=change-me-to-a-long-random-string
# Default Super Admin seeded on first `npm run seed` (upserted by email).
ADMIN_EMAIL=admin@bccchurch.co.ke
ADMIN_PASSWORD=
# Public website URL — builds the "set your password" invite links
# emailed to new admins. Set to your production site URL.
# Local website dev server: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email — HTTPS API recommended on Render (SMTP ports time out there).
# Option A (recommended): Resend over HTTPS — free tier, verify one sender.
RESEND_API_KEY=
# Option B/C: SendGrid or Brevo HTTPS APIs (pick one, priority Resend > SendGrid > Brevo).
# SENDGRID_API_KEY=
# BREVO_API_KEY=
# Option D (local dev only): SMTP fallback — Gmail times out on Render, use API above in prod.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
SMTP_PASS=
EMAIL_FROM=

# Facebook -> blog auto-sync (optional).
# Setup: create a Meta app, add the church Facebook page, generate a
# long-lived Page access token (server-side only, never expose to frontend).
# Leave unset to disable; SYNC_SECRET guards the manual sync endpoint.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0
FACEBOOK_SYNC_INTERVAL_MINUTES=0
SYNC_SECRET=

# File uploads (blog/event images + media publishes land in ./uploads,
# served at /uploads/...). Override with an absolute path if needed.
# NOTE (Render free tier): the filesystem is ephemeral — redeploys wipe
# uploads. Move to S3/Cloudinary when the library grows.
# UPLOADS_DIR=/var/data/uploads

# Media-team publisher: service photos -> Facebook Page (optional).
# Same Page token as above, but it must be granted the *publish*
# permission (pages_manage_posts / pages_manage_engagement). The sync
# above is read-only and works with a lesser token; publishing will
# fail with a clear error until the token can publish.

# Instagram reels + photos (optional).
# Needs an Instagram Business/Creator account linked to the Page.
# Token needs instagram_basic + instagram_content_publish.
# Localhost files can't be fetched by Meta — publishing needs the
# backend on a public URL (YOUR_APP_URL, e.g. Render).
INSTAGRAM_BUSINESS_ID=
# Defaults to FACEBOOK_PAGE_ACCESS_TOKEN when unset.
# INSTAGRAM_ACCESS_TOKEN=

# TikTok direct video posts (optional).
# Needs a TikTok developer app approved for the Content Posting API
# (video.upload scope) + a user access token from Login Kit.
# Until then the TikTok target reports "not connected".
TIKTOK_ACCESS_TOKEN=
