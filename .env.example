# Facebook -> blog auto-sync (optional).
# Setup: create a Meta app, add the church Facebook page, generate a
# long-lived Page access token (server-side only, never expose to frontend).
# Leave unset to disable; SYNC_SECRET guards the manual sync endpoint.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0
FACEBOOK_SYNC_INTERVAL_MINUTES=0
SYNC_SECRET=
