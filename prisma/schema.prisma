generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String

  @@map("users")
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  excerpt   String
  category  String
  author    String
  imageUrl  String?
  published Boolean  @default(true)
  // Origin of the post: "local" (written in-house) or "facebook" (synced
  // from the church Facebook page by facebook.service.ts).
  source         String  @default("local")
  sourceUrl      String?
  facebookPostId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model ContactMessage {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  newsletter Boolean @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model GivingRecord {
  id                String   @id @default(uuid())
  amount            Decimal  @db.Decimal(12, 2)
  givingType        String
  phoneNumber       String
  email             String?
  message           String?
  transactionId     String?
  checkoutRequestId String?  @unique
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  @@map("giving_records")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String   @default("website")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}
